# Public Supabase connection values. These are safe to expose to the browser; RLS remains authoritative.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only security and deployment values.
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SECRET=
APP_ORIGIN=http://localhost:3000
APP_ENV=local

# The public login identifier maps to the single provisioned Supabase Auth user.
# Keep the password in Supabase Auth; never commit it or place it in NEXT_PUBLIC variables.
BONUSHUB_ADMIN_USERNAME=
BONUSHUB_ADMIN_EMAIL=

# Google Calendar OAuth, configured per environment in Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
INTEGRATION_ENCRYPTION_KEY=

# Explicit non-production visual review only.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_DEMO_MODE=false

# Optional: real isolated PostgreSQL instance for integration tests.
TEST_DATABASE_URL=
